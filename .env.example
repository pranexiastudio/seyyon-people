# ==============================================================================
# SEYYON PEOPLE — Multi-Tenant HRMS SaaS Environment Configuration
# Company: Pranexia Studio | Product: Seyyon People
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000
VITE_APP_NAME="Seyyon People"
VITE_COMPANY_NAME="Pranexia Studio"

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seyyon_people?schema=public"

# Redis & BullMQ Configuration (for background jobs, presence, notifications)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT & Authentication Secrets
# (Never use development secrets in production. Generate 64-char cryptographically secure keys)
JWT_SECRET="seyyon_people_dev_super_secret_access_jwt_key_pranexia_studio_2026"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="seyyon_people_dev_super_secret_refresh_jwt_key_pranexia_studio_2026"
JWT_REFRESH_EXPIRATION="7d"

# Initial Super Admin Bootstrap Credentials (Used ONLY on initial DB seeding)
SUPER_ADMIN_EMAIL="superadmin@seyyonpeople.com"
SUPER_ADMIN_PASSWORD="SeyyonAdminSecure2026!"
SUPER_ADMIN_NAME="Seyyon Platform SuperAdmin"

# Storage Configuration (Local Adapter for Dev / S3 Compatible for Production)
STORAGE_DRIVER=local # Options: local | s3
STORAGE_LOCAL_ROOT="./uploads"
# S3 / MinIO Configuration (If STORAGE_DRIVER=s3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="seyyon-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true

# Email Notification Configuration (SMTP / Mock)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@seyyonpeople.com"

# Application Base URLs
APP_WEB_URL="http://localhost:5173"
APP_API_URL="http://localhost:4000"
