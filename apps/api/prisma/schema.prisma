datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. SAAS PLATFORM & MULTI-TENANCY
// ==============================================================================

enum PlanTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum UserRole {
  PLATFORM_SUPER_ADMIN
  COMPANY_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  PROBATION
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum AttendancePunchSource {
  WEB
  MOBILE
  BIOMETRIC_DEVICE
  MANUAL_ENTRY
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  COMPENSATORY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  FINALIZED
  PAID
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ChannelType {
  DIRECT
  GROUP
  DEPARTMENT
  COMPANY
  PROJECT
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  IMPORT
  APPROVE
  REJECT
  FINALIZE
  PASSWORD_RESET
}

model SubscriptionPlan {
  id            String             @id @default(uuid())
  tier          PlanTier           @unique
  name          String
  priceMonthly  Decimal            @db.Decimal(10, 2)
  priceYearly   Decimal            @db.Decimal(10, 2)
  maxEmployees  Int
  featuresJson  Json               @default("{}")
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions TenantSubscription[]
}

model Tenant {
  id               String               @id @default(uuid())
  name             String
  slug             String               @unique
  domain           String?
  logoUrl          String?
  address          String?
  currency         String               @default("INR")
  timezone         String               @default("Asia/Kolkata")
  planTier         PlanTier             @default(STARTER)
  status           SubscriptionStatus   @default(TRIALING)
  maxEmployees     Int                  @default(50)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  users            User[]
  activationTokens EmployeeActivationToken[]
  employees        Employee[]
  departments      Department[]
  designations     Designation[]
  shifts           Shift[]
  attendance       AttendanceRecord[]
  attendanceCorrections AttendanceCorrectionRequest[]
  leaveTypeConfigs LeaveTypeConfig[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  holidays         Holiday[]
  salaryStructures SalaryStructure[]
  payrollCycles    PayrollCycle[]
  payslips         Payslip[]
  projects         Project[]
  tasks            Task[]
  chatChannels     ChatChannel[]
  meetings         Meeting[]
  documents        EmployeeDocument[]
  performanceCycles PerformanceCycle[]
  performanceReviews PerformanceReview[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  subscription     TenantSubscription?

  @@index([status])
  @@index([slug])
}

model TenantSubscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tenantId])
}

// ==============================================================================
// 2. USERS, ROLES & AUTH
// ==============================================================================

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             UserRole      @default(EMPLOYEE)
  tenantId         String?
  tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String?       @unique
  employee         Employee?     @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  isActive         Boolean       @default(true)
  activationPending Boolean      @default(false)
  activationToken  EmployeeActivationToken?
  avatarUrl        String?
  lastLoginAt      DateTime?
  refreshTokenHash String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  chatMembers      ChatMember[]
  sentMessages     ChatMessage[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([tenantId, role])
  @@index([email])
}

model EmployeeActivationToken {
  id                 String    @id @default(uuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash          String    @unique
  expiresAt          DateTime
  sentAt             DateTime?
  consumedAt         DateTime?
  lastRequestedAt    DateTime  @default(now())
  requestWindowStart DateTime  @default(now())
  requestCount       Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, userId])
  @@index([expiresAt])
}

model RolePermission {
  id         String   @id @default(uuid())
  tenantId   String?
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([tenantId, role, permission])
  @@index([tenantId, role])
}

// ==============================================================================
// 3. ORGANIZATION & EMPLOYEES
// ==============================================================================

model Department {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  managerId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employees    Employee[]
  designations Designation[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Designation {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  code         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  level        Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employees    Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
}

model Employee {
  id                    String         @id @default(uuid())
  tenantId              String
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?          @relation("UserEmployee")
  employeeCode          String
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  gender                String?
  dateOfBirth           DateTime?
  dateOfJoining         DateTime
  dateOfExit            DateTime?
  employmentType        EmploymentType @default(FULL_TIME)
  status                EmployeeStatus @default(ACTIVE)
  
  departmentId          String
  department            Department     @relation(fields: [departmentId], references: [id])
  designationId         String
  designation           Designation    @relation(fields: [designationId], references: [id])
  managerId             String?
  manager               Employee?      @relation("ReportingHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates          Employee[]     @relation("ReportingHierarchy")
  
  // Sensitive Statutory & Bank Details (Restricted Access)
  panNumber             String?
  aadharNumber          String?
  uanNumber             String?
  bankAccount           String?
  bankIfsc              String?
  
  // Emergency Contact & Personal
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  avatarUrl             String?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrectionRequest[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  salaryStructures      SalaryStructure[]
  payslips              Payslip[]
  projectMembers        ProjectMember[]
  assignedTasks         Task[]         @relation("TaskAssignee")
  createdTasks          Task[]         @relation("TaskCreator")
  meetingAttendees      MeetingAttendee[]
  documents             EmployeeDocument[]
  performanceReviews    PerformanceReview[] @relation("EmployeeReviews")
  managedReviews        PerformanceReview[] @relation("ManagerReviews")

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
  @@index([tenantId, managerId])
}

// ==============================================================================
// 4. ATTENDANCE & SHIFTS
// ==============================================================================

model Shift {
  id                      String   @id @default(uuid())
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                    String
  startTime               String   // "09:00"
  endTime                 String   // "18:00"
  gracePeriodMinutes      Int      @default(15)
  halfDayThresholdHours   Float    @default(4.0)
  isNightShift            Boolean  @default(false)
  isDefault               Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
}

model AttendanceRecord {
  id                 String                @id @default(uuid())
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date               DateTime              @db.Date
  checkInTime        DateTime?
  checkOutTime       DateTime?
  status             AttendanceStatus      @default(ABSENT)
  totalWorkHours     Float                 @default(0.0)
  lateMinutes        Int                   @default(0)
  earlyExitMinutes   Int                   @default(0)
  overtimeMinutes    Int                   @default(0)
  source             AttendancePunchSource @default(WEB)
  ipAddress          String?
  deviceId           String?
  isManualCorrection Boolean               @default(false)
  approvedById       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  corrections        AttendanceCorrectionRequest[]

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@index([tenantId, employeeId])
}

model AttendanceCorrectionRequest {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceRecordId String?
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  requestedDate      DateTime         @db.Date
  requestedCheckIn   DateTime
  requestedCheckOut  DateTime
  reason             String
  status             LeaveStatus      @default(PENDING) // PENDING, APPROVED, REJECTED
  approvedById       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId, status])
}

// ==============================================================================
// 5. LEAVE & HOLIDAYS
// ==============================================================================

model LeaveTypeConfig {
  id                 String         @id @default(uuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  code               LeaveType
  totalAnnualDays    Float          @default(12.0)
  isPaid             Boolean        @default(true)
  carryForwardMax    Float          @default(0.0)
  requiresApproval   Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model LeaveBalance {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId        String
  leaveType          LeaveTypeConfig @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year               Int
  allocatedDays      Float
  usedDays           Float           @default(0.0)
  pendingDays        Float           @default(0.0)
  remainingDays      Float
  updatedAt          DateTime        @updatedAt

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId])
}

model LeaveRequest {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId        String
  leaveType          LeaveTypeConfig @relation(fields: [leaveTypeId], references: [id])
  startDate          DateTime        @db.Date
  endDate            DateTime        @db.Date
  totalDays          Float
  reason             String
  status             LeaveStatus     @default(PENDING)
  currentApprovalStep Int            @default(1)
  approverNotes      String?
  appliedAt          DateTime        @default(now())
  approvedAt         DateTime?
  approvedById       String?
  cancelledAt        DateTime?

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

model Holiday {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime @db.Date
  isOptional  Boolean  @default(false)
  description String?
  year        Int

  @@unique([tenantId, date])
  @@index([tenantId, year])
}

// ==============================================================================
// 6. PAYROLL & COMPENSATION
// ==============================================================================

model SalaryStructure {
  id                     String    @id @default(uuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFromDate      DateTime  @db.Date
  effectiveToDate        DateTime? @db.Date
  
  // Earnings
  basicSalary            Decimal   @db.Decimal(12, 2)
  hra                    Decimal   @db.Decimal(12, 2)
  da                     Decimal   @default(0.0) @db.Decimal(12, 2)
  specialAllowance       Decimal   @default(0.0) @db.Decimal(12, 2)
  conveyance             Decimal   @default(0.0) @db.Decimal(12, 2)
  medicalAllowance       Decimal   @default(0.0) @db.Decimal(12, 2)
  customEarningsJson     Json      @default("{}")

  // Deductions & Statutory Configuration
  pfApplicable           Boolean   @default(true)
  esiApplicable          Boolean   @default(false)
  ptApplicable           Boolean   @default(true)
  tdsProjectedMonthly    Decimal   @default(0.0) @db.Decimal(12, 2)
  
  isCurrent              Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId, employeeId, isCurrent])
}

model PayrollCycle {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month            Int           // 1 to 12
  year             Int
  startDate        DateTime      @db.Date
  endDate          DateTime      @db.Date
  status           PayrollStatus @default(DRAFT)
  totalGross       Decimal       @default(0.0) @db.Decimal(14, 2)
  totalDeductions  Decimal       @default(0.0) @db.Decimal(14, 2)
  totalNet         Decimal       @default(0.0) @db.Decimal(14, 2)
  processedById    String?
  approvedById     String?
  finalizedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payslips         Payslip[]

  @@unique([tenantId, month, year])
  @@index([tenantId, status])
}

model Payslip {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollCycleId     String
  payrollCycle       PayrollCycle  @relation(fields: [payrollCycleId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslipNumber      String
  
  // Attendance & Days
  totalWorkingDays   Float
  daysPresent        Float
  lossOfPayDays      Float         @default(0.0)
  
  // Earnings Breakup
  basicSalary        Decimal       @db.Decimal(12, 2)
  hra                Decimal       @db.Decimal(12, 2)
  da                 Decimal       @default(0.0) @db.Decimal(12, 2)
  specialAllowance   Decimal       @default(0.0) @db.Decimal(12, 2)
  otherAllowances    Decimal       @default(0.0) @db.Decimal(12, 2)
  grossEarnings      Decimal       @db.Decimal(12, 2)
  
  // Deductions Breakup
  pfEmployee         Decimal       @default(0.0) @db.Decimal(12, 2)
  esiEmployee        Decimal       @default(0.0) @db.Decimal(12, 2)
  professionalTax    Decimal       @default(0.0) @db.Decimal(12, 2)
  incomeTaxTds       Decimal       @default(0.0) @db.Decimal(12, 2)
  otherDeductions    Decimal       @default(0.0) @db.Decimal(12, 2)
  totalDeductions    Decimal       @db.Decimal(12, 2)
  
  netPay             Decimal       @db.Decimal(12, 2)
  paymentMode        String        @default("BANK_TRANSFER")
  paymentStatus      String        @default("PENDING")
  paidAt             DateTime?
  payslipPdfUrl      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([tenantId, payrollCycleId, employeeId])
  @@unique([tenantId, payslipNumber])
  @@index([tenantId, employeeId])
}

// ==============================================================================
// 7. PROJECTS & WORK MANAGEMENT (TASKS)
// ==============================================================================

model Project {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  status      String          @default("ACTIVE")
  startDate   DateTime?       @db.Date
  endDate     DateTime?       @db.Date
  clientName  String?
  ownerId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members     ProjectMember[]
  tasks       Task[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String   @default("MEMBER")
  joinedAt   DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model Task {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  status         TaskStatus    @default(TODO)
  priority       TaskPriority  @default(MEDIUM)
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?        @default(0.0)
  creatorId      String
  creator        Employee      @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId     String?
  assignee       Employee?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentTaskId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  comments       TaskComment[]

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, projectId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ==============================================================================
// 8. TEAM COLLABORATION & CHAT
// ==============================================================================

model ChatChannel {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        ChannelType   @default(DEPARTMENT)
  description String?
  isPrivate   Boolean       @default(false)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     ChatMember[]
  messages    ChatMessage[]

  @@index([tenantId])
}

model ChatMember {
  id        String      @id @default(uuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String      @default("MEMBER")
  joinedAt  DateTime    @default(now())
  lastReadAt DateTime   @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String      @id @default(uuid())
  channelId      String
  channel        ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  attachmentUrl  String?
  attachmentType String?
  isEdited       Boolean     @default(false)
  editedAt       DateTime?
  isDeleted      Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([channelId, createdAt])
}

// ==============================================================================
// 9. MEETINGS & CALENDAR
// ==============================================================================

model Meeting {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  timeZone       String            @default("Asia/Kolkata")
  locationOrUrl  String?
  organizerId    String
  status         MeetingStatus     @default(SCHEDULED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  attendees      MeetingAttendee[]

  @@index([tenantId, startTime])
}

model MeetingAttendee {
  id            String   @id @default(uuid())
  meetingId     String
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status        String   @default("INVITED") // INVITED, ACCEPTED, DECLINED, TENTATIVE
  responseNotes String?

  @@unique([meetingId, employeeId])
  @@index([employeeId])
}

// ==============================================================================
// 10. DOCUMENTS & NOTIFICATIONS
// ==============================================================================

model EmployeeDocument {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category       String   // ID_PROOF, OFFER_LETTER, EXPERIENCE, CERTIFICATE, CONTRACT
  title          String
  fileUrl        String
  fileSizeBytes  Int
  mimeType       String
  expiryDate     DateTime? @db.Date
  isConfidential Boolean   @default(false)
  uploadedById   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, employeeId])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  linkUrl   String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId, userId, isRead])
}

// ==============================================================================
// 11. PERFORMANCE REVIEWS & AUDIT
// ==============================================================================

model PerformanceCycle {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  startDate   DateTime            @db.Date
  endDate     DateTime            @db.Date
  status      String              @default("ACTIVE")
  description String?
  createdAt   DateTime            @default(now())

  reviews     PerformanceReview[]

  @@index([tenantId])
}

model PerformanceReview {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  performanceCycleId String
  performanceCycle   PerformanceCycle @relation(fields: [performanceCycleId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee         @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId         String
  reviewer           Employee         @relation("ManagerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  selfRating         Float?
  managerRating      Float?
  selfComments       String?
  managerComments    String?
  finalScore         Float?
  status             String           @default("DRAFT") // DRAFT, SUBMITTED, REVIEWED, COMPLETED
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([tenantId, performanceCycleId, employeeId])
  @@index([tenantId, reviewerId])
}

model AuditLog {
  id            String      @id @default(uuid())
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail     String?
  action        AuditAction
  entityType    String      // EMPLOYEE, PAYROLL, ATTENDANCE, LEAVE, etc.
  entityId      String?
  oldValuesJson Json?
  newValuesJson Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType])
}
