{
  "name": "seyyon-people-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Seyyon People — All-in-One Multi-tenant HRMS & Workforce Collaboration SaaS by Pranexia Studio",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@seyyon/web",
    "dev:api": "npm run start:dev --workspace=@seyyon/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@seyyon/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@seyyon/api",
    "prisma:seed": "npm run prisma:seed --workspace=@seyyon/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@nestjs/platform-express@10.4.22": {
      "multer": "2.5.0",
      "body-parser": "1.20.9"
    },
    "@nestjs/swagger@7.4.2": {
      "lodash": "4.18.1"
    },
    "js-yaml@^4.0.0": "4.3.2",
    "qs@^6.0.0": "6.16.1",
    "ajv@^8.0.0": "8.20.0",
    "@angular-devkit/core@17.3.11": {
      "ajv": "8.20.0",
      "picomatch": "4.0.7"
    },
    "@nestjs/cli@10.4.9": {
      "glob": "10.5.0",
      "webpack": "5.104.1",
      "inquirer": "8.2.7"
    },
    "@angular-devkit/schematics-cli@17.3.11": {
      "inquirer": "9.3.8"
    }
  },
  "keywords": [
    "hrms",
    "saas",
    "multi-tenant",
    "workforce",
    "payroll",
    "attendance",
    "nest-js",
    "react",
    "tailwind"
  ],
  "author": "Pranexia Studio",
  "license": "UNLICENSED"
}
